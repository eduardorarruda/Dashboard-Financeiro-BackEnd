# Copie para .env e preencha. O .env nunca vai para o git.
PORT=3000
NODE_ENV=development
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# PostgreSQL (destino)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboard_financeiro
DB_USER=postgres
DB_PASSWORD=

# Firebird (origem da migração)
FDB_HOST=
FDB_PORT=3050
FDB_DATABASE=
FDB_USER=
FDB_PASSWORD=

# Opcional: módulo seu, fora do repositório, que exporta decryptPassword(senhaCifrada)
LEGACY_DECRYPT_MODULE=
